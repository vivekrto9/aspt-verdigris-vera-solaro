{
  "templateKey": "aspt-verdigris-vera-solaro",
  "displayName": "Vera Solaro — Verdigris Almanac",
  "repo": {
    "url": "https://github.com/vivekrto9/aspt-verdigris-vera-solaro.git",
    "commitSha": "RESOLVED_AT_TEMPLATE_REGISTRATION"
  },
  "stage": "production-template",
  "runtime": {
    "type": "official-emdash-astro-cloudflare",
    "scaffold": {
      "package": "create-emdash",
      "version": "0.14.0",
      "template": "cloudflare:starter"
    },
    "requiredFiles": [
      "astro.config.mjs",
      "src/live.config.ts",
      "src/worker.ts",
      "wrangler.jsonc"
    ],
    "adminPath": "/_emdash/admin",
    "apiPrefix": "/_emdash/api"
  },
  "leads": {
    "required": true,
    "path": "astropages/leads.manifest.json"
  },
  "cloudflare": {
    "runtimeContractStatus": "defined",
    "wranglerConfig": "wrangler.jsonc",
    "environments": [
      {
        "name": "preview",
        "workerName": "aspt-verdigris-vera-solaro-preview",
        "d1DatabaseName": "aspt-verdigris-vera-solaro-preview-site",
        "r2BucketName": "aspt-verdigris-vera-solaro-preview-media",
        "kvNamespaceName": "aspt-verdigris-vera-solaro-preview-session",
        "emailQueueName": "aspt-verdigris-vera-solaro-preview-email",
        "emailDeadLetterQueueName": "aspt-verdigris-vera-solaro-preview-email-dlq",
        "siteUrlVariable": "PREVIEW_SITE_URL",
        "d1DatabaseIdVariable": "PREVIEW_SITE_D1_DATABASE_ID",
        "sessionKvNamespaceIdVariable": "PREVIEW_SITE_SESSION_KV_NAMESPACE_ID"
      },
      {
        "name": "production",
        "workerName": "aspt-verdigris-vera-solaro-production",
        "d1DatabaseName": "aspt-verdigris-vera-solaro-production-site",
        "r2BucketName": "aspt-verdigris-vera-solaro-production-media",
        "kvNamespaceName": "aspt-verdigris-vera-solaro-production-session",
        "emailQueueName": "aspt-verdigris-vera-solaro-production-email",
        "emailDeadLetterQueueName": "aspt-verdigris-vera-solaro-production-email-dlq",
        "siteUrlVariable": "PRODUCTION_SITE_URL",
        "d1DatabaseIdVariable": "PRODUCTION_SITE_D1_DATABASE_ID",
        "sessionKvNamespaceIdVariable": "PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID"
      }
    ],
    "bindings": [
      {
        "name": "DB",
        "type": "d1",
        "purpose": "EmDash and generated-site runtime data"
      },
      {
        "name": "MEDIA",
        "type": "r2",
        "purpose": "EmDash media storage"
      },
      {
        "name": "SESSION",
        "type": "kv",
        "purpose": "Astro and EmDash session storage"
      },
      {
        "name": "LOADER",
        "type": "worker_loader",
        "purpose": "EmDash plugin sandboxing"
      },
      {
        "name": "IMAGES",
        "type": "images",
        "purpose": "Astro Cloudflare image transformation"
      },
      {
        "name": "EMAIL_QUEUE",
        "type": "queue",
        "purpose": "Durable transactional and newsletter email delivery"
      }
    ]
  },
  "secrets": {
    "requiredNow": [
      "EMDASH_ENCRYPTION_KEY",
      "BUILDER_MCP_TOKEN",
      "BUILDER_MCP_PROVISION_SECRET"
    ],
    "requiredForTemplateDeployment": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_DEV_WORKERS_SUBDOMAIN",
      "EMDASH_ENCRYPTION_KEY",
      "BUILDER_MCP_TOKEN",
      "BUILDER_MCP_PROVISION_SECRET"
    ],
    "requiredForGeneratedSiteDeployment": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_DEV_WORKERS_SUBDOMAIN",
      "EMDASH_ENCRYPTION_KEY",
      "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN",
      "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL",
      "ASTROPAGES_SSO_PUBLIC_JWK",
      "CLOUDFLARE_SECRETS_STORE_ID"
    ],
    "deploymentVariables": [
      "GH_REPOSITORY_VARIABLES_TOKEN",
      "CLOUDFLARE_SECRETS_STORE_ID",
      "PREVIEW_SITE_D1_DATABASE_ID",
      "PREVIEW_SITE_SESSION_KV_NAMESPACE_ID",
      "PREVIEW_SITE_URL",
      "PRODUCTION_SITE_D1_DATABASE_ID",
      "PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID",
      "PRODUCTION_SITE_URL"
    ],
    "deploymentMapping": {
      "workerSecretsFile": "aspt-verdigris-vera-solaro-worker-secrets.json",
      "workerSecrets": [
        "EMDASH_ENCRYPTION_KEY",
        "BUILDER_MCP_TOKEN",
        "BUILDER_MCP_PROVISION_SECRET"
      ],
      "generatedSiteWorkerSecrets": [
        "EMDASH_ENCRYPTION_KEY",
        "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN"
      ],
      "generatedSiteRuntimeVars": [
        "ASTROPAGES_PROJECT_ID",
        "ASTROPAGES_SITE_ENVIRONMENT",
        "ASTROPAGES_SSO_PUBLIC_JWK"
      ],
      "secretStoreBundleBinding": "ASTROPAGES_INTEGRATION_SECRETS_JSON",
      "platformGooglePlacesBinding": "ASTROPAGES_PLATFORM_GOOGLE_PLACES_API_KEY"
    },
    "valuesAllowedInSource": false,
    "generatedSiteRuntimeConfig": [
      "SES_SENDER_EMAIL",
      "SES_SENDER_NAME",
      "AWS_REGION",
      "STRIPE_PUBLISHABLE_KEY",
      "VERA_CALENDLY_NATAL_HOUR_CALL_URI",
      "VERA_CALENDLY_NATAL_HOUR_IN_PERSON_URI",
      "VERA_CALENDLY_YEAR_AHEAD_CALL_URI",
      "VERA_CALENDLY_YEAR_AHEAD_IN_PERSON_URI",
      "VERA_CALENDLY_TWO_CHARTS_CALL_URI",
      "VERA_CALENDLY_TWO_CHARTS_IN_PERSON_URI",
      "POSTHOG_PROJECT_API_KEY",
      "POSTHOG_HOST",
      "POSTHOG_PROJECT_ID"
    ],
    "providerCredentials": [
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "CALENDLY_API_TOKEN",
      "CALENDLY_WEBHOOK_SIGNING_KEY",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "GOOGLE_PLACES_API_KEY",
      "POSTHOG_PROJECT_API_KEY",
      "POSTHOG_HOST",
      "POSTHOG_PROJECT_ID",
      "POSTHOG_PERSONAL_API_KEY"
    ]
  },
  "localization": {
    "strategy": "query-param",
    "requiredDefaultLocale": "en",
    "defaultLocale": "en",
    "activeLocales": [
      "en"
    ],
    "availableLocaleCatalog": [
      "en"
    ],
    "maxActiveLocales": 8,
    "rtlSupported": false,
    "editableContentSource": "emdash-flat-section-collections",
    "publicEditableCollection": "multiple",
    "publicEditableEntries": [
      "site_chrome/main",
      "site_pages/home",
      "site_pages/not_found_page",
      "vera_home_sections/main",
      "vera_readings/main",
      "vera_booking/main",
      "vera_booking_payment/main",
      "vera_writing/main",
      "vera_article/main",
      "vera_about/main",
      "vera_questions/main",
      "vera_contact/main",
      "vera_legal/main",
      "vera_letters/main",
      "vera_letters_status/main",
      "vera_account/main",
      "vera_account_room/main",
      "vera_account_schedule/main",
      "vera_account_cancel/main",
      "vera_account_receipt/main",
      "vera_closed/main",
      "vera_auth/main"
    ],
    "disabledLocalePolicy": "available locales remain inactive until AstroPages enables and verifies translated copy"
  },
  "workflows": {
    "template": {
      "provider": "woodpecker",
      "configurationSource": "signed-control-plane-extension",
      "entrypoint": "pnpm run astropages:pipeline",
      "purposes": {
        "ci": "template_ci",
        "preview": "template_preview",
        "production": "template_production"
      },
      "githubSafetyCi": ".github/workflows/ci.yml",
      "catalogScreenshots": "admin-managed"
    },
    "generatedSite": {
      "previewSeed": ".astropages/generated-site-workflows/deploy-preview.yml",
      "previewInstalledPath": ".github/workflows/deploy-preview.yml",
      "previewTrigger": "control-plane-workflow-dispatch",
      "previewCallback": {
        "statusRoute": "/callback/preview-deployments/:previewDeploymentId/status",
        "auth": "service-bearer",
        "urlSource": "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL"
      },
      "productionSeed": ".astropages/generated-site-workflows/deploy-production.yml",
      "productionInstalledPath": ".github/workflows/deploy-production.yml",
      "productionTrigger": "control-plane-workflow-dispatch",
      "productionCallback": {
        "statusRoute": "/callback/production-deployments/:productionDeploymentId/status",
        "auth": "service-bearer",
        "urlSource": "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL"
      }
    }
  },
