---
import {
  getSafePublicNextPath,
  loadPublicPageContent,
} from "../builder/public-page.ts";
import VeraBrandMark from "../components/vera/VeraBrandMark.astro";
import VeraFrame from "../components/vera/VeraFrame.astro";

export const prerender = false;

const page = await loadPublicPageContent(Astro, "login");
const { builderEdit } = page;
const safeNext = getSafePublicNextPath(Astro.url);
const signupHref = `/signup?next=${encodeURIComponent(safeNext)}`;
const forgotHref = `/forgot-password?next=${encodeURIComponent(safeNext)}`;
const content: Record<string, string> = {
  ...page.content,
  seo_title: page.content.login_seo_title,
  seo_description: page.content.login_seo_description,
  seo_canonical_path: page.content.login_seo_canonical_path,
  seo_robots: page.content.auth_seo_robots,
  og_title: page.content.login_seo_title,
  og_description: page.content.login_seo_description,
  og_image: page.content.auth_social_image,
  og_image_alt: page.content.auth_social_image_alt,
  twitter_card: page.content.auth_twitter_card,
  twitter_title: page.content.login_seo_title,
  twitter_description: page.content.login_seo_description,
  twitter_image: page.content.auth_social_image,
};
---

<VeraFrame {...page} content={content} currentPath="/account" showHeader={false} showFooter={false}>
  <section class="vera-page-hero vera-page-hero--split">
    <div>
      <VeraBrandMark
        alt={content.auth_logo_alt}
        field="auth_logo_alt"
        edit={builderEdit}
      />
      <p class="vera-eyebrow" style="margin-top: 34px" {...builderEdit("auth_eyebrow")}>
        {content.auth_eyebrow}
      </p>
      <h1 id="login-title" class="vera-display" {...builderEdit("login_title")}>
        {content.login_title}
      </h1>
      <p class="vera-lede" {...builderEdit("login_intro")}>{content.login_intro}</p>
    </div>

    <form
      class="vera-form-card"
      data-auth-form
      data-next-path={safeNext}
      aria-labelledby="login-form-title"
    >
      <fieldset>
        <legend
          id="login-form-title"
          style="font-family: var(--vera-font-display); font-size: 30px; color: var(--vera-aubergine); letter-spacing: 0; text-transform: none"
          {...builderEdit("login_form_title")}
        >
          {content.login_form_title}
        </legend>
        <label class="vera-field">
          <span class="vera-label" {...builderEdit("email_label")}>{content.email_label}</span>
          <input
            class="vera-input"
            type="email"
            name="email"
            autocomplete="email"
            required
            aria-describedby="login-email-error"
          />
          <span
            id="login-email-error"
            class="vera-form-note"
            data-field-error="email"
            data-auth-invalid
            hidden
            {...builderEdit("auth_email_invalid_error")}
          >
            {content.auth_email_invalid_error}
          </span>
        </label>
        <label class="vera-field">
          <span class="vera-label" {...builderEdit("password_label")}>{content.password_label}</span>
          <input
            class="vera-input"
            type="password"
            name="password"
            autocomplete="current-password"
            required
            minlength="8"
            aria-describedby="login-password-hint login-password-error"
          />
          <span id="login-password-hint" class="vera-form-note" {...builderEdit("password_hint")}>
            {content.password_hint}
          </span>
          <span
            id="login-password-error"
            class="vera-form-note"
            data-field-error="password"
            data-auth-invalid
            hidden
            {...builderEdit("auth_password_short_error")}
          >
            {content.auth_password_short_error}
          </span>
        </label>
        <a
          class="vera-card-meta"
          style="color: var(--vera-burnt); text-decoration: none"
          href={forgotHref}
          {...builderEdit("login_forgot_cta")}
        >
          {content.login_forgot_cta}
        </a>
        <button
          class="vera-button vera-button--burnt vera-button--shadow"
          type="submit"
          {...builderEdit("login_submit_cta")}
        >
          {content.login_submit_cta}
        </button>
        <div aria-live="polite" aria-atomic="true">
          <p class="vera-form-note" data-auth-status="submitting" hidden {...builderEdit("login_submitting_status")}>
            {content.login_submitting_status}
          </p>
          <p class="vera-form-note" data-auth-status="error" hidden {...builderEdit("login_error_status")}>
            {content.login_error_status}
          </p>
          <p class="vera-form-note" data-auth-status="rate-limited" hidden {...builderEdit("login_rate_limited_status")}>
            {content.login_rate_limited_status}
          </p>
          <p class="vera-form-note" data-auth-status="verification-success" hidden {...builderEdit("verification_success_status")}>
            {content.verification_success_status}
          </p>
        </div>
        <p class="vera-form-note">
          <span {...builderEdit("login_switch_prompt")}>{content.login_switch_prompt}</span>{" "}
          <a href={signupHref} style="color: var(--vera-burnt)" {...builderEdit("signup_link")}>
            {content.signup_link}
          </a>
        </p>
      </fieldset>
    </form>
  </section>
</VeraFrame>

<script>
  import {
    bindField,
    createStatusBoard,
    failureState,
    fieldErrorNote,
    isLongEnough,
    looksLikeEmail,
    requireInput,
    submitIsAllowed,
    type AuthField,
  } from "../scripts/vera/auth/forms.ts";

  const form = document.querySelector<HTMLFormElement>("[data-auth-form]");
  const submit = form?.querySelector<HTMLButtonElement>("button[type='submit']");
  const showStatus = createStatusBoard();

  if (new URL(window.location.href).searchParams.get("verification") === "success") {
    showStatus("verification-success");
  }

  if (form) {
    const email: AuthField = {
      input: requireInput(form, "email"),
      error: fieldErrorNote(form, "email"),
      validate: looksLikeEmail,
    };
    const password: AuthField = {
      input: requireInput(form, "password"),
      error: fieldErrorNote(form, "password"),
      validate: (value) => isLongEnough(value),
    };
    bindField(email);
    bindField(password);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitIsAllowed([email, password])) {
        showStatus("");
        return;
      }

      showStatus("submitting");
      if (submit) submit.disabled = true;

      try {
        const response = await fetch("/api/astropages/generated-site/customer-auth/login", {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            email: email.input.value.trim(),
            password: password.input.value,
          }),
        });
        const payload = await response.json().catch(() => null) as { status?: string } | null;
        if (!response.ok || payload?.status !== "ready") {
          showStatus(failureState(response.status));
          if (submit) submit.disabled = false;
          return;
        }
        window.location.assign(form.dataset.nextPath || "/account");
      } catch {
        showStatus("error");
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
