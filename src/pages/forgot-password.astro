---
import {
  getSafePublicNextPath,
  loadPublicPageContent,
} from "../builder/public-page.ts";
import VeraBrandMark from "../components/vera/VeraBrandMark.astro";
import VeraFrame from "../components/vera/VeraFrame.astro";

export const prerender = false;

const page = await loadPublicPageContent(Astro, "forgot_password");
const { builderEdit } = page;
const safeNext = getSafePublicNextPath(Astro.url);
const loginHref = `/login?next=${encodeURIComponent(safeNext)}`;
const content: Record<string, string> = {
  ...page.content,
  seo_title: page.content.forgot_seo_title,
  seo_description: page.content.forgot_seo_description,
  seo_canonical_path: page.content.forgot_seo_canonical_path,
  seo_robots: page.content.auth_seo_robots,
  og_title: page.content.forgot_seo_title,
  og_description: page.content.forgot_seo_description,
  og_image: page.content.auth_social_image,
  og_image_alt: page.content.auth_social_image_alt,
  twitter_card: page.content.auth_twitter_card,
  twitter_title: page.content.forgot_seo_title,
  twitter_description: page.content.forgot_seo_description,
  twitter_image: page.content.auth_social_image,
};
---

<VeraFrame {...page} content={content} currentPath="/account" showHeader={false} showFooter={false}>
  <section class="vera-page-hero vera-page-hero--split">
    <div>
      <VeraBrandMark
        alt={content.auth_logo_alt}
        field="auth_logo_alt"
        edit={builderEdit}
      />
      <p class="vera-eyebrow" style="margin-top: 34px" {...builderEdit("auth_eyebrow")}>
        {content.auth_eyebrow}
      </p>
      <h1 id="forgot-password-title" class="vera-display" {...builderEdit("forgot_title")}>
        {content.forgot_title}
      </h1>
      <p class="vera-lede" {...builderEdit("forgot_intro")}>{content.forgot_intro}</p>
    </div>

    <form
      class="vera-form-card"
      data-password-reset-request-form
      aria-labelledby="forgot-form-title"
    >
      <fieldset>
        <legend
          id="forgot-form-title"
          style="font-family: var(--vera-font-display); font-size: 30px; color: var(--vera-aubergine); letter-spacing: 0; text-transform: none"
          {...builderEdit("forgot_form_title")}
        >
          {content.forgot_form_title}
        </legend>
        <label class="vera-field">
          <span class="vera-label" {...builderEdit("email_label")}>{content.email_label}</span>
          <input
            class="vera-input"
            type="email"
            name="email"
            autocomplete="email"
            required
            aria-describedby="forgot-email-error"
          />
          <span
            id="forgot-email-error"
            class="vera-form-note"
            data-field-error="email"
            data-auth-invalid
            hidden
            {...builderEdit("auth_email_invalid_error")}
          >
            {content.auth_email_invalid_error}
          </span>
        </label>
        <button
          class="vera-button vera-button--burnt vera-button--shadow"
          type="submit"
          {...builderEdit("forgot_submit_cta")}
        >
          {content.forgot_submit_cta}
        </button>
        <div aria-live="polite" aria-atomic="true">
          <p class="vera-form-note" data-auth-status="submitting" hidden {...builderEdit("forgot_submitting_status")}>
            {content.forgot_submitting_status}
          </p>
          <p class="vera-form-note" data-auth-status="success" hidden {...builderEdit("forgot_success_status")}>
            {content.forgot_success_status}
          </p>
          <p class="vera-form-note" data-auth-status="error" hidden {...builderEdit("forgot_error_status")}>
            {content.forgot_error_status}
          </p>
          <p class="vera-form-note" data-auth-status="rate-limited" hidden {...builderEdit("forgot_rate_limited_status")}>
            {content.forgot_rate_limited_status}
          </p>
        </div>
        <p class="vera-form-note">
          <span {...builderEdit("forgot_switch_prompt")}>{content.forgot_switch_prompt}</span>{" "}
          <a href={loginHref} style="color: var(--vera-burnt)" {...builderEdit("login_link")}>
            {content.login_link}
          </a>
        </p>
      </fieldset>
    </form>
  </section>
</VeraFrame>

<script>
  import {
    bindField,
    createStatusBoard,
    failureState,
    fieldErrorNote,
    looksLikeEmail,
    requireInput,
    submitIsAllowed,
    type AuthField,
  } from "../scripts/vera/auth/forms.ts";

  const form = document.querySelector<HTMLFormElement>("[data-password-reset-request-form]");
  const submit = form?.querySelector<HTMLButtonElement>("button[type='submit']");
  const showStatus = createStatusBoard();

  if (form) {
    const email: AuthField = {
      input: requireInput(form, "email"),
      error: fieldErrorNote(form, "email"),
      validate: looksLikeEmail,
    };
    bindField(email);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!submitIsAllowed([email])) {
        showStatus("");
        return;
      }

      showStatus("submitting");
      if (submit) submit.disabled = true;

      try {
        const response = await fetch(
          "/api/astropages/generated-site/customer-auth/request-password-reset",
          {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ email: email.input.value.trim() }),
          },
        );
        const payload = await response.json().catch(() => null) as { status?: string } | null;
        if (!response.ok || payload?.status !== "ready") {
          showStatus(failureState(response.status));
          return;
        }
        // The link itself is never painted on screen; it reaches the reader by email.
        showStatus("success");
      } catch {
        showStatus("error");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
