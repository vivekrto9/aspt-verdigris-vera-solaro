{
  "name": "@astropages/aspt-verdigris-vera-solaro",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Vera Solaro",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "wrangler:dev": "wrangler dev --local --port 4331",
    "dev:admin-proxy": "node scripts/dev/local-admin-proxy.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply aspt-verdigris-vera-solaro-site --local",
    "d1:verify:local": "wrangler d1 execute aspt-verdigris-vera-solaro-site --local --file database/d1/verify_runtime_tables.sql",
    "d1:schema:check": "node scripts/validate-d1-schema.mjs",
    "cloudflare:contract": "node scripts/validate-cloudflare-runtime.mjs",
    "cloudflare:contract:check": "node scripts/validate-cloudflare-runtime.mjs",
    "cloudflare:resources:print": "node scripts/print-cloudflare-resource-plan.mjs",
    "scan:safety": "node scripts/scan-safety.mjs",
    "astropages:pipeline": "node scripts/astropages-pipeline.mjs",
    "project-assets:contract": "node scripts/validate-project-assets-contract.mjs",
    "project-assets:contract:write": "node scripts/validate-project-assets-contract.mjs --write",
    "sales:contract": "node scripts/validate-sales-contract.mjs",
    "users-data:contract": "node scripts/validate-users-data-contract.mjs",
    "secrets:contract": "node scripts/validate-secrets-contract.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "pnpm run project-assets:contract && pnpm run sales:contract && pnpm run users-data:contract && pnpm run secrets:contract && pnpm run test && pnpm run scan:safety && pnpm run d1:schema:check && pnpm run cloudflare:contract && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.3",
    "@astrojs/react": "^5.0.0",
    "@emdash-cms/cloudflare": "^0.14.0",
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/rye": "5.3.0",
    "@fontsource/ultra": "5.3.0",
    "@stripe/stripe-js": "9.13.0",
    "astro": "^6.3.0",
    "emdash": "^0.14.0",
    "posthog-js": "1.399.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@cloudflare/workers-types": "^5.20260813.1",
    "wrangler": "4.94.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
