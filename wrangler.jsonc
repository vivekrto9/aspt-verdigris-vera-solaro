{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aspt-verdigris-vera-solaro",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/_emdash/*", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aspt-verdigris-vera-solaro-site",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aspt-verdigris-vera-solaro-media",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "LOCAL_ASPT_VERDIGRIS_VERA_SOLARO_SESSION_KV",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "aspt-verdigris-vera-solaro-email",
      },
    ],
    "consumers": [
      {
        "queue": "aspt-verdigris-vera-solaro-email",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "aspt-verdigris-vera-solaro-email-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["*/2 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "env": {
    "preview": {
      "name": "aspt-verdigris-vera-solaro-preview",
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "run_worker_first": ["/_emdash/*", "/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aspt-verdigris-vera-solaro-preview-site",
          "database_id": "PREVIEW_D1_DATABASE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "aspt-verdigris-vera-solaro-preview-media",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "PREVIEW_SESSION_KV_NAMESPACE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "aspt-verdigris-vera-solaro-preview-email",
          },
        ],
        "consumers": [
          {
            "queue": "aspt-verdigris-vera-solaro-preview-email",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 60,
            "dead_letter_queue": "aspt-verdigris-vera-solaro-preview-email-dlq",
          },
        ],
      },
      "triggers": {
        "crons": ["*/2 * * * *"],
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1,
        },
      },
      "secrets": {
        "required": [
          "EMDASH_ENCRYPTION_KEY",
          "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN"
        ],
      },
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
    },
    "production": {
      "name": "aspt-verdigris-vera-solaro-production",
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "run_worker_first": ["/_emdash/*", "/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aspt-verdigris-vera-solaro-production-site",
          "database_id": "PRODUCTION_D1_DATABASE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "aspt-verdigris-vera-solaro-production-media",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "PRODUCTION_SESSION_KV_NAMESPACE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "aspt-verdigris-vera-solaro-production-email",
          },
        ],
        "consumers": [
          {
            "queue": "aspt-verdigris-vera-solaro-production-email",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 60,
            "dead_letter_queue": "aspt-verdigris-vera-solaro-production-email-dlq",
          },
        ],
      },
      "triggers": {
        "crons": ["*/2 * * * *"],
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1,
        },
      },
      "secrets": {
        "required": [
          "EMDASH_ENCRYPTION_KEY",
          "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN"
        ],
      },
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
    },
  },
}
